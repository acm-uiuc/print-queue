{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "acm-print-queue",
  "compatibility_date": "2026-08-31",
  "compatibility_flags": ["nodejs_compat"],
  "keep_vars": true,
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1,
  },
  "d1_databases": [
    {
      "binding": "PRINT_DB",
      "database_name": "acm-print-jobs",
      "database_id": "00000000-0000-0000-0000-000000000000",
      "migrations_dir": "./migrations",
    },
  ],
  "r2_buckets": [
    {
      "binding": "DOCUMENTS",
      "bucket_name": "acm-print-documents",
    },
  ],
  "queues": {
    "producers": [
      {
        "binding": "PRINT_QUEUE",
        "queue": "acm-print-jobs",
      },
    ],
  },
  "durable_objects": {
    "bindings": [
      {
        "name": "PRINTERS",
        "class_name": "PrinterObject",
        "script_name": "acm-print-dispatch",
      },
    ],
  },
}
