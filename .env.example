# Azure Active Directory (Entra ID) settings
VITE_AAD_TENANT_ID=your-tenant-id
VITE_AAD_CLIENT_ID=your-client-id
# Optional: override the authority if you have a custom login endpoint
# VITE_AAD_AUTHORITY=https://login.microsoftonline.com/your-tenant-id

# Redirects for local development (update to match your deployment URLs)
VITE_AAD_REDIRECT_URI=http://localhost:5173/
VITE_AAD_POST_LOGOUT_REDIRECT_URI=http://localhost:5173/
# Optional route-level redirect overrides
# VITE_AAD_LOGIN_REDIRECT_URI=http://localhost:5173/
# VITE_AAD_LOGOUT_REDIRECT_URI=http://localhost:5173/login

VITE_AAD_SCOPES=User.Read

# API settings
VITE_API_BASE_URL=http://localhost:3000/api
