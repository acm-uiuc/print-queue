# Azure Active Directory (Entra ID) settings
VITE_AAD_TENANT_ID=c8d9148f-9a59-4db3-827d-42ea0c2b6e2e
VITE_AAD_CLIENT_ID=9e89c87f-7d86-43b1-afda-04db5feeef1e
# Optional: override the authority if you have a custom login endpoint
# VITE_AAD_AUTHORITY=https://login.microsoftonline.com/c8d9148f-9a59-4db3-827d-42ea0c2b6e2e

# Redirects for local development (update to match your deployment URLs)
VITE_AAD_REDIRECT_URI=http://localhost:5173/
VITE_AAD_POST_LOGOUT_REDIRECT_URI=http://localhost:5173/

# Scopes to request on login (comma-separated). User.Read fetches basic profile info.
VITE_AAD_SCOPES=User.Read
